# Must be the same Web Client ID as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGIN_REGEX kann für einen anderen Host oder Port überschrieben werden.
# Supabase project URL and server-only service_role key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Development uses the explicit payment placeholder. Set APP_ENV=production to disable it.
APP_ENV=development
PAYMENT_PLACEHOLDER_ENABLED=true
LISTING_FEE_CHF=0
LISTING_DURATION_DAYS=30

# Required when several API instances run in production.
# REDIS_URL=redis://localhost:6379/0

# Production domain protection (example)
# ENFORCE_HTTPS=true
# ALLOWED_HOSTS=api.example.ch
