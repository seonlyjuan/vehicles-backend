# Copy to .env.production for a deployment; keep the completed file private.
APP_ENV=production
CLIENT_ORIGIN=https://app.example.ch
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALLOWED_HOSTS=api.example.ch
ENFORCE_HTTPS=true
PORT=8000
WEB_CONCURRENCY=1

# Set to the trusted TLS proxy's IP or network, as specified by the hoster.
# Use * only when the API port is reachable exclusively through that proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Required for multiple workers OR multiple replicas. Prefer TLS for remote Redis.
# REDIS_URL=rediss://user:password@redis.example.ch:6379/0
